  "rules": [
    {
      "id": "precedence.project-rules",
      "severity": "block",
      "tags": [
        "global"
      ],
      "statement": "Прямые указания пользователя, ближайший AGENTS.md и действующие ADR имеют приоритет над внешним навыком.",
      "remediation": "Удалить или заменить внешнее требование, которое меняет проектный порядок приоритетов.",
      "sourceIds": [
        "agents-general",
        "adr-069-decision"
      ]
    },
    {
      "id": "authority.architecture-human",
      "severity": "block",
      "tags": [
        "architecture",
        "planning",
        "global"
      ],
      "statement": "Архитектурные решения согласуются с человеком и фиксируются в ADR с синхронным обновлением PROJECT_ARCHITECTURE.md.",
      "remediation": "Заменить автономное архитектурное решение остановкой затронутой части и подготовкой ADR.",
      "sourceIds": [
        "agents-adr-sync",
        "architecture-lifecycle",
        "adr-068-decision"
      ]
    },
    {
      "id": "planning.tsk-only",
      "severity": "block",
      "tags": [
        "planning",
        "artifacts"
      ],
      "statement": "Постоянный общий план хранится в корневом TSK; отдельные PLN, ExecPlan и параллельные плановые иерархии не создаются.",
      "remediation": "Проецировать полезную декомпозицию в Plan или Execution существующего TSK и временные пакеты в .tmp.",
      "sourceIds": [
        "adr-031-decision",
        "adr-068-decision",
        "task-format",
        "task-hierarchy"
      ]
    },
    {
      "id": "activation.cubica-explicit",
      "severity": "block",
      "tags": [
        "activation",
        "orchestration",
        "global"
      ],
      "statement": "$cubica включается только по явному указанию пользователя.",
      "remediation": "Удалить автоматический вызов $cubica; специализированный навык должен выполнять только свою способность.",
      "sourceIds": [
        "agents-autonomous",
        "adr-068-decision"
      ]
    },
    {
      "id": "activation.specialists-automatic",
      "severity": "guidance",
      "tags": [
        "activation",
        "global"
      ],
      "statement": "Допущенные специализированные навыки могут включаться автоматически через точное описание.",
      "remediation": "Сузить description до конкретных симптомов и задач, исключив мета-оркестрацию.",
      "sourceIds": [
        "agents-autonomous",
        "adr-069-decision"
      ]
    },
    {
      "id": "activation.candidates-inert",
      "severity": "block",
      "tags": [
        "activation",
        "adaptation",
        "global"
      ],
      "statement": "Неадаптированный внешний навык из skill-candidates является только референсом и не может выполняться, включаться или попадать в путь автоматического обнаружения.",
      "remediation": "Оставить точный снимок в skill-candidates и материализовать отдельную очищенную проектную версию в skills после смысловой адаптации.",
      "sourceIds": [
        "agents-general",
        "adr-069-decision"
      ]
    },
    {
      "id": "orchestration.no-meta-bootstrap",
      "severity": "block",
      "tags": [
        "orchestration",
        "subagents",
        "planning",
        "activation"
      ],
      "statement": "Специализированный навык не вводит обязательный сквозной процесс, не проверяет навыки перед каждым ответом и не запускает собственную иерархию субагентов.",
      "remediation": "Заблокировать мета-навык либо извлечь из него узкую способность без bootstrap-инструкций.",
      "sourceIds": [
        "adr-068-decision",
        "adr-069-decision"
      ]
    },
    {
      "id": "subagents.lifecycle",
      "severity": "review",
      "tags": [
        "subagents",
        "orchestration"
      ],
      "statement": "Запущенные субагенты получают ограниченное задание, проверяются главным агентом и явно закрываются.",
      "remediation": "Добавить границы задания, проверку различия и явное завершение либо удалить делегирование из навыка.",
      "sourceIds": [
        "agents-execution",
        "adr-068-decision"
      ]
    },
    {
      "id": "operations.git-state",
      "severity": "review",
      "tags": [
        "git",
        "delivery",
        "debugging"
      ],
      "statement": "Внешний навык не должен автоматически менять ветку, рабочее дерево, историю, создавать commit, push, PR или worktree.",
      "remediation": "Заменить действие рекомендацией проверить состояние и выполнить операцию только по прямому запросу и с учетом локальных правил.",
      "sourceIds": [
        "agents-execution",
        "adr-069-decision"
      ]
    },
    {
      "id": "operations.destructive-approval",
      "severity": "block",
      "tags": [
        "security",
        "git",
        "delivery",
        "global"
      ],
      "statement": "Разрушительные, необратимые внешние операции, права и секреты требуют отдельного подтверждения.",
      "remediation": "Остановить затронутую операцию и запросить разрешение, продолжая независимую безопасную работу.",
      "sourceIds": [
        "adr-068-decision",
        "task-approval"
      ]
    },
    {
      "id": "verification.risk-based",
      "severity": "review",
      "tags": [
        "testing",
        "verification",
        "debugging",
        "global"
      ],
      "statement": "Доказательство выбирается по риску и области изменения; нельзя безусловно требовать полный набор тестов после каждой локальной правки.",
      "remediation": "Требовать свежую достаточную проверку конкретного утверждения и честно указывать непроверенные границы.",
      "sourceIds": [
        "agents-execution",
        "adr-068-decision"
      ]
    },
    {
      "id": "data.schema-ssot",
      "severity": "block",
      "tags": [
        "contracts",
        "schema",
        "architecture"
      ],
      "statement": "Декларативные контракты и JSON Schema нельзя заменять изолированной императивной проверкой.",
      "remediation": "Расширить каноническую схему и валидировать стандартным JSON Schema validator.",
      "sourceIds": [
        "agents-contracts"
      ]
    },
    {
      "id": "artifacts.temporary-root",
      "severity": "review",
      "tags": [
        "artifacts",
        "debugging",
        "testing",
        "global"
      ],
      "statement": "Временные файлы создаются только в .tmp и очищаются после использования.",
      "remediation": "Перенести временный артефакт в .tmp либо оформить значимый результат как постоянный артефакт задачи.",
      "sourceIds": [
        "agents-temp"
      ]
    },
    {
      "id": "adaptation.materialize",
      "severity": "block",
      "tags": [
        "adaptation",
        "global"
      ],
      "statement": "Активный навык не должен содержать в одном контексте конфликтующее upstream-требование и противоположную проектную обертку.",
      "remediation": "Материализовать очищенную проектную версию и сохранить upstream отдельно как доказательство происхождения.",
      "sourceIds": [
        "adr-069-decision"
      ]
    }
  ],
  "checks": {
    "forbiddenActivePatterns": [
      "ARCHITECT_PLAN",
      "\\bPLN-[A-Za-z0-9_-]*",
      "using-superpowers",
      "using-agent-skills",
      "invoke.*before ANY response",
      "MUST invoke.*skill"
    ],
    "signalPatterns": [
      {
        "id": "git-state",
        "pattern": "\\b(git (commit|push|checkout|switch|bisect|worktree)|create (a )?PR)\\b",
        "tags": [
          "git",
          "delivery"
        ]
      },
      {
        "id": "planning-artifact",
        "pattern": "\\b(PLN-|ExecPlan|ARCHITECT_PLAN|implementation plan|design document)\\b",
        "tags": [
          "planning",
          "artifacts"
        ]
      },
      {
        "id": "subagent",
        "pattern": "\\b(subagent|parallel agent|dispatching agent)\\b",
        "tags": [
          "subagents",
          "orchestration"
        ]
      },
      {
        "id": "approval",
        "pattern": "\\b(approval|approve|sign[- ]?off|checkpoint)\\b",
        "tags": [
          "planning",
          "approval"
        ]
      },
      {
        "id": "strong-imperative",
        "pattern": "\\b(MUST|ALWAYS|NEVER|non-negotiable|no exceptions)\\b",
        "tags": [
          "semantics"
        ]
      },
      {
        "id": "full-verification",
        "pattern": "\\b(full test|full suite|every test|fresh verification|complete verification)\\b",
        "tags": [
          "testing",
          "verification"
        ]
      }
    ]
  }
}
