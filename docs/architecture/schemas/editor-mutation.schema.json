{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cubica.platform/schemas/editor-mutation.schema.json",
  "title": "EditorMutationRequest",
  "$ref": "#/definitions/EditorMutationRequest",
  "definitions": {
    "JsonValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/definitions/JsonValue" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/JsonValue" }
        }
      ]
    },
    "JsonPatchOperation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "value"],
          "properties": {
            "op": { "const": "add" },
            "path": { "type": "string" },
            "value": { "$ref": "#/definitions/JsonValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "value"],
          "properties": {
            "op": { "const": "replace" },
            "path": { "type": "string" },
            "value": { "$ref": "#/definitions/JsonValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path"],
          "properties": {
            "op": { "const": "remove" },
            "path": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "value"],
          "properties": {
            "op": { "const": "test" },
            "path": { "type": "string" },
            "value": { "$ref": "#/definitions/JsonValue" }
          }
        }
      ]
    },
    "EditorChangeSetJsonPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filePath", "operations"],
      "properties": {
        "filePath": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "array",
          "items": { "$ref": "#/definitions/JsonPatchOperation" }
        }
      }
    },
    "EditorChangeSetTextPatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filePath", "description"],
      "properties": {
        "filePath": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "beforeText": { "type": "string" },
        "afterText": { "type": "string" }
      }
    },
    "EditorChangeSetFileCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filePath", "text"],
      "properties": {
        "filePath": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      }
    },
    "EditorChangeSetFileDelete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filePath"],
      "properties": {
        "filePath": { "type": "string", "minLength": 1 },
        "previousText": { "type": "string" }
      }
    },
    "EditorChangeSetFileRename": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromFilePath", "toFilePath"],
      "properties": {
        "fromFilePath": { "type": "string", "minLength": 1 },
        "toFilePath": { "type": "string", "minLength": 1 }
      }
    },
    "EditorChangeSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "jsonPatches"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "intentId": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "jsonPatches": {
          "type": "array",
          "items": { "$ref": "#/definitions/EditorChangeSetJsonPatch" }
        },
        "textPatches": {
          "type": "array",
          "items": { "$ref": "#/definitions/EditorChangeSetTextPatch" }
        },
        "fileCreates": {
          "type": "array",
          "items": { "$ref": "#/definitions/EditorChangeSetFileCreate" }
        },
        "fileDeletes": {
          "type": "array",
          "items": { "$ref": "#/definitions/EditorChangeSetFileDelete" }
        },
        "fileRenames": {
          "type": "array",
          "items": { "$ref": "#/definitions/EditorChangeSetFileRename" }
        }
      }
    },
    "EditorMutationActiveDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "versionHash"],
      "properties": {
        "text": { "type": "string" },
        "versionHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "EditorMutationPrepareRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "gameId", "sessionId", "activeFilePath", "activeDocument", "changeSet"],
      "properties": {
        "action": { "const": "prepare" },
        "gameId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "activeFilePath": { "type": "string", "minLength": 1 },
        "activeDocument": { "$ref": "#/definitions/EditorMutationActiveDocument" },
        "changeSet": { "$ref": "#/definitions/EditorChangeSet" }
      }
    },
    "EditorMutationConfirmRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "gameId", "sessionId", "activeFilePath", "activeDocument", "changeSet", "effectDigest"],
      "properties": {
        "action": { "const": "confirm" },
        "gameId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "activeFilePath": { "type": "string", "minLength": 1 },
        "activeDocument": { "$ref": "#/definitions/EditorMutationActiveDocument" },
        "changeSet": { "$ref": "#/definitions/EditorChangeSet" },
        "effectDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "EditorMutationDirectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "gameId", "sessionId", "activeFilePath", "activeDocument", "changeSet"],
      "properties": {
        "action": { "const": "direct" },
        "gameId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "activeFilePath": { "type": "string", "minLength": 1 },
        "activeDocument": { "$ref": "#/definitions/EditorMutationActiveDocument" },
        "changeSet": { "$ref": "#/definitions/EditorChangeSet" }
      }
    },
    "EditorMutationRequest": {
      "oneOf": [
        { "$ref": "#/definitions/EditorMutationPrepareRequest" },
        { "$ref": "#/definitions/EditorMutationConfirmRequest" },
        { "$ref": "#/definitions/EditorMutationDirectRequest" }
      ]
    },
    "EditorMutationDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "source", "pointer", "message"],
      "properties": {
        "severity": { "enum": ["error", "warning"] },
        "source": { "type": "string" },
        "pointer": { "type": "string" },
        "message": { "type": "string" },
        "filePath": { "type": "string" }
      }
    },
    "EditorMutationDiffSummaryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filePath", "pointer", "operation", "description"],
      "properties": {
        "filePath": { "type": "string" },
        "pointer": { "type": "string" },
        "operation": { "enum": ["add", "replace", "remove", "test"] },
        "description": { "type": "string" }
      }
    },
    "EditorMutationDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filePath", "text", "previousVersionHash", "versionHash"],
      "properties": {
        "filePath": { "type": "string" },
        "text": { "type": "string" },
        "previousVersionHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "versionHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "EditorMutationPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "diagnostics"],
      "properties": {
        "ready": { "type": "boolean" },
        "playerUrl": { "type": "string" },
        "sourceMaps": {
          "type": "array",
          "items": { "$ref": "#/definitions/EditorMutationPreviewSourceMap" }
        },
        "diagnostics": {
          "type": "array",
          "items": { "$ref": "#/definitions/EditorMutationDiagnostic" }
        }
      }
    },
    "EditorMutationPreviewSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "pointer"],
      "properties": {
        "file": { "type": "string" },
        "pointer": { "type": "string" }
      }
    },
    "EditorMutationPreviewSourceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedFile", "sourceFile", "mappings"],
      "properties": {
        "generatedFile": { "type": "string" },
        "sourceFile": { "type": "string" },
        "mappings": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/EditorMutationPreviewSource" }
          }
        },
        "verbatimSubtrees": { "type": "array", "items": { "type": "string" } }
      }
    },
    "EditorMutationPreparedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "status", "summary", "effectDigest", "risk", "riskReasons", "documents", "inverseChangeSet", "changedPointersByFile", "diffSummary", "diagnostics", "preview"],
      "properties": {
        "ok": { "const": true },
        "status": { "const": "prepared" },
        "summary": { "type": "string" },
        "effectDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "risk": { "enum": ["safe", "structural", "dangerous"] },
        "riskReasons": { "type": "array", "items": { "type": "string" } },
        "documents": { "type": "array", "items": { "$ref": "#/definitions/EditorMutationDocument" } },
        "inverseChangeSet": { "$ref": "#/definitions/EditorChangeSet" },
        "changedPointersByFile": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "diffSummary": { "type": "array", "items": { "$ref": "#/definitions/EditorMutationDiffSummaryItem" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/definitions/EditorMutationDiagnostic" } },
        "preview": { "$ref": "#/definitions/EditorMutationPreview" }
      }
    },
    "EditorMutationConfirmedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "status", "summary", "effectDigest", "documents", "inverseChangeSet", "changedPointersByFile", "diffSummary"],
      "properties": {
        "ok": { "const": true },
        "status": { "enum": ["confirmed", "direct"] },
        "summary": { "type": "string" },
        "effectDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "documents": { "type": "array", "items": { "$ref": "#/definitions/EditorMutationDocument" } },
        "inverseChangeSet": { "$ref": "#/definitions/EditorChangeSet" },
        "changedPointersByFile": {
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "diffSummary": { "type": "array", "items": { "$ref": "#/definitions/EditorMutationDiffSummaryItem" } }
      }
    },
    "EditorMutationNoOpResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "status", "summary", "diagnostics"],
      "properties": {
        "ok": { "const": true },
        "status": { "const": "no-op" },
        "summary": { "type": "string" },
        "diagnostics": { "type": "array", "items": { "$ref": "#/definitions/EditorMutationDiagnostic" } }
      }
    }
  }
}
