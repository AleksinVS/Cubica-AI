{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubica.ai/schemas/session/facilitator-debrief.schema.json",
  "title": "FacilitatorDebriefResponse",
  "description": "Facilitator-only status and accepted AI debrief draft derived from a pinned gameplay journal boundary.",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "sessionId",
    "gameId",
    "status",
    "canGenerate"
  ],
  "properties": {
    "format": { "const": "cubica.facilitator-debrief" },
    "schemaVersion": { "const": "1.0.0" },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "gameId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "status": { "enum": ["absent", "generating", "ready", "failed"] },
    "canGenerate": { "type": "boolean" },
    "runId": { "type": "string", "pattern": "^debrief_[A-Za-z0-9_-]{8,128}$" },
    "requestedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "journalSha256": { "$ref": "#/$defs/Sha256" },
    "throughEventSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "provider": { "const": "z.ai" },
    "model": { "const": "glm-4.7" },
    "promptVersion": { "const": "facilitator-debrief-ru-v1" },
    "draft": { "$ref": "#/$defs/FacilitatorDebriefDraft" },
    "error": { "$ref": "#/$defs/FacilitatorDebriefError" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "absent" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "canGenerate": { "const": true },
          "runId": false,
          "requestedAt": false,
          "completedAt": false,
          "journalSha256": false,
          "throughEventSequence": false,
          "provider": false,
          "model": false,
          "promptVersion": false,
          "draft": false,
          "error": false
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "generating" } },
        "required": ["status"]
      },
      "then": {
        "required": [
          "runId",
          "requestedAt",
          "journalSha256",
          "throughEventSequence",
          "provider",
          "model",
          "promptVersion"
        ],
        "properties": {
          "canGenerate": { "const": false },
          "completedAt": false,
          "draft": false,
          "error": false
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "ready" } },
        "required": ["status"]
      },
      "then": {
        "required": [
          "runId",
          "requestedAt",
          "completedAt",
          "journalSha256",
          "throughEventSequence",
          "provider",
          "model",
          "promptVersion",
          "draft"
        ],
        "properties": {
          "canGenerate": { "const": false },
          "error": false
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": {
        "required": [
          "runId",
          "requestedAt",
          "completedAt",
          "journalSha256",
          "throughEventSequence",
          "provider",
          "model",
          "promptVersion",
          "error"
        ],
        "properties": {
          "canGenerate": { "const": true },
          "draft": false
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "EventSequenceReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    },
    "FacilitatorDebriefFact": {
      "type": "object",
      "required": ["statement", "eventSequences"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "eventSequences": { "$ref": "#/$defs/EventSequenceReferences" }
      },
      "additionalProperties": false
    },
    "FacilitatorDebriefInterpretation": {
      "type": "object",
      "required": ["statement", "confidence", "eventSequences"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "eventSequences": { "$ref": "#/$defs/EventSequenceReferences" }
      },
      "additionalProperties": false
    },
    "FacilitatorDebriefQuestion": {
      "type": "object",
      "required": ["question", "eventSequences"],
      "properties": {
        "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "eventSequences": { "$ref": "#/$defs/EventSequenceReferences" }
      },
      "additionalProperties": false
    },
    "FacilitatorDebriefDraft": {
      "type": "object",
      "required": ["title", "summary", "facts", "interpretations", "reflectionQuestions"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "facts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/FacilitatorDebriefFact" }
        },
        "interpretations": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/FacilitatorDebriefInterpretation" }
        },
        "reflectionQuestions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/FacilitatorDebriefQuestion" }
        }
      },
      "additionalProperties": false
    },
    "FacilitatorDebriefError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "provider_unavailable",
            "provider_timeout",
            "provider_rejected",
            "provider_outcome_unknown",
            "provider_invalid_response",
            "input_too_large",
            "internal_error"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "FacilitatorDebriefGenerationRequest": {
      "type": "object",
      "required": ["expectedStateVersion"],
      "properties": {
        "expectedStateVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  }
}
