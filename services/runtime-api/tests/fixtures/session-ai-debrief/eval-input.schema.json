{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubica.ai/schemas/eval/session-ai-debrief-eval-input.schema.json",
  "title": "SessionAiDebriefEvalInput",
  "type": "object",
  "required": ["format", "schemaVersion", "methodology", "qualityRubric", "scenarios"],
  "properties": {
    "format": { "const": "cubica.session-ai-debrief-eval-input" },
    "schemaVersion": { "const": "1.0.0" },
    "methodology": { "type": "string", "enum": ["methodology.json"] },
    "qualityRubric": {
      "type": "object",
      "required": ["id", "description", "prohibitedPatterns", "humanReviewRequired", "limitation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "prohibitedPatterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "humanReviewRequired": { "const": true },
        "limitation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "journal", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "journal": {
            "type": "string",
            "enum": ["cmt-public-journal.json", "neutral-public-journal.json", "null-journal.json"]
          },
          "expected": {
            "type": "object",
            "required": ["journalSchema", "responseSchema", "semantics", "quality"],
            "properties": {
              "journalSchema": { "enum": ["pass", "fail"] },
              "responseSchema": { "enum": ["pass", "fail"] },
              "semantics": { "enum": ["pass", "fail", "not-run"] },
              "quality": { "enum": ["pass", "fail"] }
            },
            "additionalProperties": false
          },
          "sections": {}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
