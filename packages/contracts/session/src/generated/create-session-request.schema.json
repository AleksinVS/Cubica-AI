{
  "type": "object",
  "required": [
    "gameId"
  ],
  "properties": {
    "gameId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "contentSourceId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,80}$"
    },
    "participantCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional number of local participants. Runtime checks this against the published manifest bounds."
    }
  },
  "additionalProperties": false
}
