{
  "$schema": "../../../../docs/architecture/schemas/ui-authoring-v2.schema.json",
  "_schemaVersion": "2.0",
  "_manifestType": "ui",
  "_channel": "web",
  "_definitions": {},
  "root": {
    "_type": "ui.Manifest",
    "_label": "Web-интерфейс: Estate Race · S3",
    "_semantics": "UI S3: поле отображает подтверждённую сессию, публичные результаты карточек, состояние тюрьмы, аукцион и только серверно объявленные действия.",
    "meta": {
      "id": "estate-race.ui.web",
      "version": "0.3.0",
      "schema_version": "1.0",
      "game_id": "estate-race",
      "game_manifest_version": "0.3.0",
      "channel": "web",
      "author": "Cubica"
    },
    "entry_point": "table",
    "screen_routing": [
      {
        "screenKey": "table",
        "conditions": {
          "screenId": "table",
          "layoutMode": "topbar"
        }
      }
    ],
    "screens": [
      {
        "id": "table",
        "_type": "ui.Screen",
        "_label": "Экран table: Estate Race · S3",
        "_semantics": "Экран UI-манифеста table: setup, auction, tax, карточки и jail только показывают подтверждённое состояние и объявленные сервером действия.",
        "title": "Estate Race · S3",
        "layout_mode": "topbar",
        "root": {
          "_type": "ui.Component",
          "_label": "Корневой контейнер table root",
          "_semantics": "UI-компонент типа screenComponent.",
          "id": "table.root",
          "type": "screenComponent",
          "props": {
            "cssClass": "board-game-shell"
          },
          "children": [
            {
              "_type": "ui.Component",
              "_label": "Область table header",
              "_semantics": "UI-компонент типа areaComponent.",
              "id": "table.header",
              "type": "areaComponent",
              "props": {
                "cssClass": "board-game-header"
              },
              "children": [
                {
                  "_type": "ui.Component",
                  "_label": "Estate Race · S3 Ход · активен · этап",
                  "_semantics": "UI-компонент типа richTextComponent.",
                  "id": "table.title",
                  "type": "richTextComponent",
                  "props": {
                    "html": "<h1>Estate Race · S3</h1><p>Ход {{game.state.public.turn.turnNumber}} · активен {{game.state.public.turn.activePlayerId}} · этап {{game.state.public.turn.phase}}</p><p>Карточки, тюрьма, покупка, рента и аукцион отображаются из подтверждённой проекции; доступные действия и их доступность объявляет сервер.</p>"
                  }
                }
              ]
            },
            {
              "_type": "ui.Component",
              "_label": "Публичное состояние аукциона",
              "_semantics": "Показывает только server-owned public.auction: объект, текущую ставку, объявленный шаг, лидера и участника восстановления хода.",
              "id": "table.auction-status",
              "type": "richTextComponent",
              "props": {
                "cssClass": "board-game-auction",
                "html": "<h2>Аукцион</h2><p>Объект {{game.state.public.auction.cellId}} · текущая ставка {{game.state.public.auction.currentBid}} · минимальный шаг {{game.state.public.auction.minimumIncrement}}</p><p>Лидер {{game.state.public.auction.leaderPlayerId}} · восстановление хода {{game.state.public.auction.resumePlayerId}}</p>"
              }
            },
            {
              "_type": "ui.Component",
              "_label": "Последняя открытая карточка",
              "_semantics": "Показывает только публичный результат последнего server-owned draw; будущий порядок колод и удерживаемые карты других участников не читаются.",
              "id": "table.card-status",
              "type": "richTextComponent",
              "props": {
                "cssClass": "board-game-card-status",
                "html": "<h2>Карточка</h2><p>Последний открытый результат: {{game.state.public.board.lastCardId}}</p>"
              }
            },
            {
              "_type": "ui.Component",
              "_label": "Состояние тюрьмы",
              "_semantics": "Показывает публичный статус активного участника; конкретные способы выхода отображаются только как server-declared DOM-действия игрового поля.",
              "id": "table.jail-status",
              "type": "richTextComponent",
              "props": {
                "cssClass": "board-game-jail-status",
                "html": "<h2>Тюрьма</h2><p>Активен {{game.state.public.turn.activePlayerId}} · этап {{game.state.public.turn.phase}}. Оплата, карта выхода и попытка дубля доступны только когда их объявил сервер.</p>"
              }
            },
            {
              "_type": "ui.Component",
              "_label": "Область table players",
              "_semantics": "UI-компонент типа areaComponent.",
              "id": "table.players",
              "type": "areaComponent",
              "props": {
                "cssClass": "board-game-players"
              },
              "children": [
                {
                  "_type": "ui.Component",
              "_label": "Участники локальной сессии",
              "_semantics": "Список 2–6 участников, их балансы и позиции отображает game-owned поле из подтверждённого снимка Runtime API.",
              "id": "table.players-summary",
              "type": "richTextComponent",
              "props": {
                "html": "<h2>Локальная партия: 2–6 участников</h2><p>Активен {{game.state.public.turn.activePlayerId}}. Балансы, позиции и статус заключения показаны непосредственно из публичной проекции.</p>"
              }
            }
              ]
            },
            {
              "_type": "ui.Component",
              "_label": "Область table workspace",
              "_semantics": "UI-компонент типа areaComponent.",
              "id": "table.workspace",
              "type": "areaComponent",
              "props": {
                "cssClass": "board-game-workspace"
              },
              "children": [
                {
                  "_type": "ui.Component",
                  "_label": "Компонент table board",
                  "_semantics": "UI-компонент типа interactiveBoardSurface.",
                  "id": "table.board",
                  "type": "interactiveBoardSurface",
                  "props": {
                    "sceneId": "main",
                    "designWidth": 1400,
                    "designHeight": 1000,
                    "accessibleLabel": "Игровое поле Estate Race"
                  }
                }
              ]
            },
            {
              "_type": "ui.Component",
              "_label": "Последний бросок: · сумма",
              "_semantics": "UI-компонент типа richTextComponent.",
              "id": "table.roll",
              "type": "richTextComponent",
              "props": {
                "cssClass": "board-game-roll",
                "html": "<p><strong>Последний бросок:</strong> {{game.state.public.board.lastRoll.values}} · сумма {{game.state.public.board.lastRoll.total}}</p>"
              }
            },
            {
              "_type": "ui.Component",
              "_label": "Краткий журнал хода",
              "_semantics": "Показывает подтверждённые Runtime API записи, не вычисляя правила в интерфейсе.",
              "id": "table.log",
              "type": "areaComponent",
              "props": {
                "cssClass": "board-game-log"
              },
              "children": [
                {
                  "_type": "ui.Component",
                  "_label": "Заголовок журнала",
                  "_semantics": "Коротко обозначает подтверждённую историю действий.",
                  "id": "table.log-title",
                  "type": "richTextComponent",
                  "props": {
                    "html": "<h2>Журнал</h2>"
                  }
                },
                {
                  "_type": "ui.Component",
                  "_label": "Записи журнала",
                  "_semantics": "Повторяет публичные записи журнала в порядке Runtime API.",
                  "id": "table.log-entries",
                  "type": "areaComponent",
                  "props": {
                    "cssClass": "board-game-log-entries"
                  },
                  "itemTemplate": {
                    "collection": "{{game.state.public.log}}",
                    "itemKey": "logEntry"
                  },
                  "children": [
                    {
                      "_type": "ui.Component",
                      "_label": "Запись журнала",
                      "_semantics": "Показывает авторское описание либо идентификатор подтверждённого действия.",
                      "id": "table.log-entry",
                      "type": "richTextComponent",
                      "props": {
                        "html": "<p><strong>{{logEntry.data.kind}}</strong> {{logEntry.summary}}</p>"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
